[Unit]
Description=Telegram video downloader
After=network-online.target
Wants=network-online.target

[Service]
User=tgvideobot
Group=tgvideobot
WorkingDirectory=/opt/tg-video-down
EnvironmentFile=/etc/tg-video-down.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/tg-video-down/.venv/bin/python bot.py
Restart=always
RestartSec=5
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tg-video-down
Environment=TMPDIR=/var/lib/tg-video-down
MemoryMax=1100M
CPUQuota=150%
TasksMax=100
UMask=0077

[Install]
WantedBy=multi-user.target
